# ==============================================================================
# MISSION CONTROL CONFIGURATION & ENVIRONMENT VARIABLES
# ==============================================================================

# Creator Studio Security Clearance Passcode:
# When defined, unlocks and protects /studio and all /api/studio/* endpoints.
# If left unset in local development, the studio opens without authentication.
STUDIO_PASSWORD=your_secure_passcode_here

# GitHub Personal Access Token (for Vercel serverless live Studio publishing):
# Generate at https://github.com/settings/tokens with 'repo' or 'contents:read and write' permissions.
# Required on Vercel so Studio updates commit directly to GitHub and trigger automatic deploys.
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_REPO_OWNER=coopeace
GITHUB_REPO_NAME=portfolio
GITHUB_REPO_BRANCH=main

# Canonical Production URL (used by Next.js metadata and OpenGraph generation):
NEXT_PUBLIC_SITE_URL=https://shishirdev.com

